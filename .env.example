# Firebase (Firestore) — paste the whole service-account JSON on one line.
# Firebase console > Project settings > Service accounts > Generate new private key.
# Never commit the real value; set it in Vercel > Settings > Environment Variables.
FIREBASE_SERVICE_ACCOUNT=

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

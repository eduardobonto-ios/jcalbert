# Firebase (Firestore) — server-side only
# Vercel: set these three from the service account JSON
#   (Firebase console > Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Local dev alternative: path to the downloaded JSON key instead of the three vars above
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

